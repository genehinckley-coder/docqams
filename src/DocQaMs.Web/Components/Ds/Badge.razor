<span @attributes="AdditionalAttributes" class="@Css.Join("d1-badge", "d1-badge--" + Css.Modifier(Tone), Class)">
    @if (Dot)
    {
        <span class="d1-badge__dot" aria-hidden="true"></span>
    }
    <span>@ChildContent</span>
</span>

@code {
    /// <summary>The text: a noun or a short state, never a sentence. It carries the status; the color only repeats it.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    /// <summary>The color.</summary>
    [Parameter]
    public BadgeTone Tone { get; set; } = BadgeTone.Neutral;

    /// <summary>Whether a dot precedes the text.</summary>
    [Parameter]
    public bool Dot { get; set; }

    /// <summary>Extra classes.</summary>
    [Parameter]
    public string? Class { get; set; }

    /// <summary>Any other attribute.</summary>
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }
}
