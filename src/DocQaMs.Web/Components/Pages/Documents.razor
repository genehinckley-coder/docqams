@page "/documents"
@implements IAsyncDisposable
@using CorpusSnapshot = DocQaMs.Core.Corpus.Corpus
@using DocQaMs.Core.Text
@inject IConversationStore Store
@inject ICorpusSource CorpusSource
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>Documents · DocQA</PageTitle>

@if (_corpus is { } corpus)
{
    CorpusDocument document = corpus.Documents[_documentIndex];
    <div class="docs">
        <aside class="docs__list" aria-label="Documents">
            <div class="docs__eyebrow">Corpus · @Formatting.Count(corpus.Documents.Count, "document")</div>
            <ul class="docs__items">
                @for (int i = 0; i < corpus.Documents.Count; i++)
                {
                    int index = i;
                    CorpusDocument item = corpus.Documents[index];
                    <li @key="index">
                        <button type="button" class="docs__row" aria-current="@(index == _documentIndex ? "true" : null)"
                                @onclick="() => SelectDocument(index)">
                            <span class="docs__row-head">
                                <span class="docs__row-label">@item.Label</span>
                                @if (_cited.Contains(index))
                                {
                                    <Badge Tone="BadgeTone.Accent">CITED</Badge>
                                }
                            </span>
                            <span class="docs__row-meta">@Counts(item)</span>
                        </button>
                    </li>
                }
            </ul>
        </aside>

        <section class="docs__main" aria-labelledby="document-title">
            @if (IsOlderCorpus(corpus))
            {
                <div class="docs__notice">
                    <Badge Tone="BadgeTone.Warning">CORPUS RELOADED</Badge>
                    <span>
                        This is the text this conversation's answers were checked against. A reload has since replaced it, so it
                        may differ from the corpus that new questions are asked about.
                    </span>
                </div>
            }

            @if (_sourceMissing)
            {
                <div class="docs__notice">
                    <Badge Tone="BadgeTone.Warning">SOURCE NOT FOUND</Badge>
                    <span>The linked source is not in this conversation, so nothing is highlighted.</span>
                </div>
            }

            <header class="docs__header">
                <div class="docs__heading">
                    <div class="docs__eyebrow">@document.FileName</div>
                    <h1 id="document-title" class="docs__title">@document.Label</h1>
                </div>
                <div class="docs__counts">@Counts(document)</div>
            </header>

            @if (ShownSource is { } source)
            {
                <div class="docs__citation">
                    <div class="docs__citation-head">
                        <span class="docs__citation-label">Source @source.Number of answer @(source.AnswerIndex + 1) · @CharacterRange(source.Check)</span>
                        <Badge Tone="SourceStatus.Tone(source.Check.Status)">@source.Check.Status.ToDisplayName()</Badge>
                    </div>
                    <p class="docs__citation-quote">“@source.Check.CitedText”</p>
                    @if (source.Check.Detail is { } detail)
                    {
                        <p class="docs__citation-detail docs__citation-detail--danger">@detail</p>
                    }
                    @if (source.Spans.Count == 0)
                    {
                        <p class="docs__citation-detail">Its span covers no text that can be highlighted.</p>
                    }
                    else if (source.Check.Status != MatchStatus.Matched)
                    {
                        <p class="docs__citation-detail">The highlight shows the text at the cited span, which is not the quote above.</p>
                    }
                    <a class="docs__back" href="@BackHref(source)">Back to the answer</a>
                </div>
            }

            @if (document.Sections.Count > 0)
            {
                <details class="docs__sections" open>
                    <summary>@Formatting.Count(document.Sections.Count, "section")</summary>
                    <div class="docs__tags">
                        @foreach (SectionHeading section in document.Sections)
                        {
                            <Tag @key="section.Paragraph" aria-label="@section.Heading" OnClick="() => RevealAsync(section.Paragraph, ScrollBlock.Start)">@section.Number</Tag>
                        }
                    </div>
                </details>
            }

            <p class="docs__caption">The extracted text, exactly as it is sent to the model.</p>
            <div class="docs__text" @key="DocumentKey(corpus, _documentIndex)">
                @for (int i = 0; i < document.Paragraphs.Count; i++)
                {
                    int index = i;
                    <DocumentParagraph @key="index" Document="document" Index="index" Highlight="HighlightOf(index)" />
                }
            </div>
        </section>
    </div>
}
else
{
    <div class="docs__empty">
        <h1 class="docs__title">Documents</h1>
        @if (_corpusState is CorpusState.Failed failed)
        {
            <div class="docs__notice">
                <Badge Tone="BadgeTone.Danger" Dot="true">CORPUS NOT LOADED</Badge>
                <span>@failed.Reason</span>
                <Button Variant="ButtonVariant.Secondary" Size="ControlSize.Sm" OnClick="RetryCorpusLoad">Retry</Button>
            </div>
        }
        else
        {
            <div class="docs__notice">
                <Badge Tone="BadgeTone.Info">CORPUS LOADING</Badge>
                <span>Extracting the pages and counting their tokens. The documents appear here once they are ready.</span>
            </div>
        }
    </div>
}

@code {
    private const string ModulePath = "./Components/Pages/Documents.razor.js";

    private static readonly IReadOnlyDictionary<int, TextRange> NoHighlights = new Dictionary<int, TextRange>();

    private IJSObjectReference? _module;
    private CorpusState _corpusState = new CorpusState.Loading();
    private ConversationSnapshot? _conversation;
    private CorpusSnapshot? _corpus;
    private int _documentIndex;
    private OpenedSource? _source;
    private bool _sourceMissing;
    private IReadOnlyDictionary<int, TextRange> _highlights = NoHighlights;
    private IReadOnlySet<int> _cited = new HashSet<int>();
    private Shape _shape;
    private (Guid? Conversation, int? Answer, int? Source)? _revealedFor;
    private int? _pendingReveal;
    private bool _disposed;

    /// <summary>
    /// The conversation whose citations are marked, from <c>?c=</c>, which the nav rail carries over from the
    /// Conversation screen. The newest is used when there is none or it does not exist.
    /// </summary>
    [SupplyParameterFromQuery(Name = "c")]
    public Guid? ConversationId { get; set; }

    /// <summary>The document shown, by its index in the corpus; the first, or the cited one, when there is none.</summary>
    [SupplyParameterFromQuery(Name = "doc")]
    public int? DocumentIndex { get; set; }

    /// <summary>With <see cref="SourceNumber"/>, the source clicked through to: the answer's index in the conversation.</summary>
    [SupplyParameterFromQuery(Name = "answer")]
    public int? AnswerIndex { get; set; }

    /// <summary>With <see cref="AnswerIndex"/>, the source clicked through to: its number, <c>[n]</c>, in that answer.</summary>
    [SupplyParameterFromQuery(Name = "source")]
    public int? SourceNumber { get; set; }

    private CorpusSnapshot? ReadyCorpus => (_corpusState as CorpusState.Ready)?.Corpus;

    // The opened source, when it is in the document on screen; the list can switch to another document.
    private OpenedSource? ShownSource => _source is { } source && source.DocumentIndex == _documentIndex ? source : null;

    /// <inheritdoc/>
    protected override void OnInitialized()
    {
        Store.Changed += OnStoreChanged;
        CorpusSource.StateChanged += OnCorpusChanged;
    }

    /// <inheritdoc/>
    protected override void OnParametersSet()
    {
        Refresh();
        UpdateReveal();
    }

    /// <inheritdoc/>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingReveal is not { } paragraph)
        {
            return;
        }

        _pendingReveal = null;
        await RevealAsync(paragraph, ScrollBlock.Center);
    }

    /// <inheritdoc/>
    public async ValueTask DisposeAsync()
    {
        _disposed = true;
        Store.Changed -= OnStoreChanged;
        CorpusSource.StateChanged -= OnCorpusChanged;
        try
        {
            if (_module is not null)
            {
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit has gone, and the browser's page with it.
        }
    }

    private void Refresh()
    {
        _corpusState = CorpusSource.State;
        _conversation = FindConversation();
        _source = FindSource(_conversation, out _sourceMissing);

        // A source is shown in the snapshot its answer was checked against; otherwise the conversation's own, or the
        // current corpus when the conversation has none yet.
        _corpus = _source?.Corpus ?? _conversation?.Corpus ?? ReadyCorpus;
        _documentIndex = _corpus is { } corpus && DocumentIndex is { } requested && requested >= 0 && requested < corpus.Documents.Count
            ? requested
            : _source?.DocumentIndex ?? 0;

        _highlights = ShownSource is { } source
            ? source.Spans.ToDictionary(span => span.Paragraph, span => span.Range)
            : NoHighlights;
        _cited = CitedDocuments(_conversation, _corpus);
        _shape = Shape.Of(_conversation, _corpusState);
    }

    // Scroll to a source once per click-through, not again whenever the conversation or corpus changes. A source the
    // store has not published yet is left pending, so that it is scrolled to when it arrives.
    private void UpdateReveal()
    {
        (Guid?, int?, int?) opened = (ConversationId, AnswerIndex, SourceNumber);
        if (_revealedFor == opened)
        {
            return;
        }

        if (ShownSource is { Spans.Count: > 0 } source)
        {
            _revealedFor = opened;
            _pendingReveal = source.Spans[0].Paragraph;
        }
        else if (_source is not null || (AnswerIndex is null && SourceNumber is null))
        {
            // Nothing to scroll to, and nothing left to wait for.
            _revealedFor = opened;
            _pendingReveal = null;
        }
    }

    private ConversationSnapshot? FindConversation() =>
        (ConversationId is { } requested ? Store.Get(requested) : null) ?? Store.List().FirstOrDefault();

    private OpenedSource? FindSource(ConversationSnapshot? conversation, out bool missing)
    {
        // Half a link, such as an answer with no source number, names no source either.
        missing = false;
        if (AnswerIndex is not { } answer || SourceNumber is not { } number)
        {
            missing = AnswerIndex is not null || SourceNumber is not null;
            return null;
        }

        if (conversation is not null
            && answer >= 0 && answer < conversation.Answers.Count
            && conversation.Answers[answer] is { Quotes: { } quotes } record
            && number >= 1 && number <= quotes.Checks.Count
            && SourceStatus.Locate(quotes.Checks[number - 1], record.Corpus) is { } located)
        {
            return new OpenedSource(conversation.Id, answer, number, quotes.Checks[number - 1], record.Corpus, located.Document, located.Spans);
        }

        missing = true;
        return null;
    }

    // Documents cited by the conversation's answers that were checked against the corpus on screen: after a reload,
    // an index into the old corpus says nothing about the new one.
    private static HashSet<int> CitedDocuments(ConversationSnapshot? conversation, CorpusSnapshot? corpus)
    {
        HashSet<int> cited = [];
        if (conversation is null || corpus is null)
        {
            return cited;
        }

        foreach (AnswerRecord record in conversation.Answers)
        {
            if (record.Quotes is not { } quotes || record.Corpus.Fingerprint != corpus.Fingerprint)
            {
                continue;
            }

            foreach (QuoteCheck check in quotes.Checks)
            {
                if (check.Citation is { } citation && citation.DocumentIndex >= 0 && citation.DocumentIndex < corpus.Documents.Count)
                {
                    cited.Add((int)citation.DocumentIndex);
                }
            }
        }

        return cited;
    }

    private bool IsOlderCorpus(CorpusSnapshot shown) => ReadyCorpus is { } current && shown.Fingerprint != current.Fingerprint;

    private TextRange? HighlightOf(int paragraph) => _highlights.TryGetValue(paragraph, out TextRange range) ? range : null;

    private static string DocumentKey(CorpusSnapshot corpus, int index) => $"{corpus.Fingerprint}:{index}";

    private static string Counts(CorpusDocument document) =>
        $"{Formatting.Number(document.CharacterCount)} characters · "
        + (document.ApproximateTokens is { } tokens ? $"about {Formatting.Number(tokens)} tokens" : "tokens not counted");

    private static string CharacterRange(QuoteCheck check) => check.Citation is { } citation
        ? $"characters {Formatting.Number(citation.StartCharIndex)}–{Formatting.Number(citation.EndCharIndex)}"
        : "";

    private string BackHref(OpenedSource source) =>
        $"{Navigation.BaseUri}?c={source.ConversationId}#answer-{source.AnswerIndex}-source-{source.Number}";

    // Choosing a document drops the opened source, as the design's does, and keeps the conversation in the address.
    private void SelectDocument(int index) => Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(new Dictionary<string, object?>
    {
        ["c"] = _conversation?.Id,
        ["doc"] = index,
        ["answer"] = null,
        ["source"] = null,
    }));

    private async Task RevealAsync(int paragraph, ScrollBlock block)
    {
        try
        {
            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", ModulePath);
            if (_module is not null && !_disposed)
            {
                await _module.InvokeVoidAsync("reveal", DocumentParagraph.IdFor(paragraph), block == ScrollBlock.Start ? "start" : "center");
            }
        }
        catch (JSDisconnectedException)
        {
            // The circuit closed; there is no page left to scroll.
        }
    }

    // Raised on whichever thread changed the store, once per streamed fragment. Only a change to which conversation is
    // shown, to its answers or to its corpus changes this screen, so everything else is ignored.
    private void OnStoreChanged(Guid id) => _ = InvokeAsync(() =>
    {
        if (_disposed || Shape.Of(FindConversation(), CorpusSource.State) == _shape)
        {
            return;
        }

        Refresh();
        UpdateReveal();
        StateHasChanged();
    });

    private void OnCorpusChanged() => _ = InvokeAsync(() =>
    {
        if (_disposed)
        {
            return;
        }

        Refresh();
        UpdateReveal();
        StateHasChanged();
    });

    private void RetryCorpusLoad()
    {
        try
        {
            // It never faults; its outcome arrives as a state change.
            _ = CorpusSource.ReloadAsync();
        }
        catch (ObjectDisposedException)
        {
            // The app is shutting down.
        }
    }

    private enum ScrollBlock
    {
        Start,
        Center,
    }

    /// <summary>A source clicked through to, resolved against the answer it belongs to.</summary>
    private sealed record OpenedSource(
        Guid ConversationId,
        int AnswerIndex,
        int Number,
        QuoteCheck Check,
        CorpusSnapshot Corpus,
        int DocumentIndex,
        IReadOnlyList<ParagraphSpan> Spans);

    /// <summary>What decides whether a store change renders this screen.</summary>
    private readonly record struct Shape(Guid? Conversation, int Answers, CorpusSnapshot? ConversationCorpus, CorpusState CorpusState)
    {
        public static Shape Of(ConversationSnapshot? conversation, CorpusState corpusState) =>
            new(conversation?.Id, conversation?.Answers.Count ?? 0, conversation?.Corpus, corpusState);
    }
}
