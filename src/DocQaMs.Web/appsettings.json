{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // Never lower this: request headers carry the API key, and bodies carry the whole corpus.
      "System.Net.Http": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  // Cache-affecting values (system prompt, labels, TTLs, thinking, models, levels) are compiled
  // constants in DocQaMs.Core's CacheAffecting class, not settings. Relative paths resolve against
  // this project's folder.
  "DocQaMs": {
    "CorpusDirectory": "../../admincode",
    "ApiKeyPath": "D:\\claude\\apikeys\\notrag_key.txt",
    "StateFilePath": "../../.docqa_state.json",
    "TokenCeiling": 400000,
    "ContextWindow": 1000000,
    "ContextWarnFraction": 0.70,
    "CacheReadToleranceFraction": 0.01,
    "MinCitationLength": 8,
    "ThinCoverageFraction": 0.50,
    "MaxTokens": {
      "Low": 32000,
      "Medium": 32000,
      "High": 32000,
      "XHigh": 64000,
      "Max": 128000
    },
    // About 2-3x the time an answer at each level's output limit takes at the measured ~95 tokens/s.
    "RequestTimeouts": {
      "Low": "00:20:00",
      "Medium": "00:20:00",
      "High": "00:20:00",
      "XHigh": "00:30:00",
      "Max": "01:00:00"
    },
    // USD per million tokens, from the published pricing page on 2026-09-13. Display only.
    "Prices": {
      "claude-opus-5": {
        "InputPerMTok": 5.00,
        "CacheWrite5mPerMTok": 6.25,
        "CacheWrite1hPerMTok": 10.00,
        "CacheReadPerMTok": 0.50,
        "OutputPerMTok": 25.00
      },
      "claude-opus-5-5": {
        "InputPerMTok": 4.00,
        "CacheWrite5mPerMTok": 5.00,
        "CacheWrite1hPerMTok": 8.00,
        "CacheReadPerMTok": 0.20,
        "OutputPerMTok": 20.00
      },
      "claude-sonnet-5": {
        "InputPerMTok": 2.00,
        "CacheWrite5mPerMTok": 2.50,
        "CacheWrite1hPerMTok": 4.00,
        "CacheReadPerMTok": 0.20,
        "OutputPerMTok": 10.00
      }
    },
    // Estimates from the plan's Cost Reference, used by every combination not in MeasuredOutputTokens.
    // High is Opus 5's measured range, which Sonnet 5 is assumed to share.
    "EstimatedOutputTokens": {
      "Low": { "Lowest": 800, "Highest": 4300 },
      "Medium": { "Lowest": 1600, "Highest": 5400 },
      "High": { "Lowest": 3200, "Highest": 6400 },
      "XHigh": { "Lowest": 4200, "Highest": 12800 },
      "Max": { "Lowest": 4800, "Highest": 19200 }
    },
    // Measured on the model itself; each replaces the estimate above and is labeled measured.
    // Opus 5: the prototype's sump answers. Opus 5.5, 2026-09-24, the sump question and one
    // follow-up: at High three pairs (5,309-8,264 output tokens), at Low and Medium one each
    // (4,643 and 3,053; 6,849 and 4,659).
    "MeasuredOutputTokens": {
      "claude-opus-5": {
        "High": { "Lowest": 3200, "Highest": 6400 }
      },
      "claude-opus-5-5": {
        "Low": { "Lowest": 3000, "Highest": 4700 },
        "Medium": { "Lowest": 4600, "Highest": 6900 },
        "High": { "Lowest": 5300, "Highest": 8300 }
      }
    }
  }
}
